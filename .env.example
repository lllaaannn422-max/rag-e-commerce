# ============================================================
# 环境变量模板 —— 复制为 .env 并填入真实值（.env 已被 .gitignore 排除）
#   Windows: copy .env.example .env
#   Linux/macOS: cp .env.example .env
# ============================================================

# ===== 必填：LLM 供应商（DeepSeek） =====
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== 可选：BGE Rerank（Xinference 本地服务；无鉴权时可留空） =====
# 格式：Bearer xf-xxxx  或留空
RERANK_API_KEY=

# ===== 可选：Tavily 联网搜索（config.WEB_SEARCH_ENABLED=False 时可留空） =====
TAVILY_API_KEY=

# ===== 可选：Redis 多轮对话记忆（不可用时自动降级为无状态单轮） =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=2
REDIS_PASSWORD=
